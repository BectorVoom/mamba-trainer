#[test]
fn fixed_seed_training_is_reproducible() {
    let dev = dev();
//! Real-data smoke and causality audits (skipped when `finance/data/bars` is absent).

mod common;

use std::time::Instant;

use clm_data::{
    FEATURE_NAMES, LabelConfig, Normalizer, Panel, compute_features, compute_labels, label_audit,
    perturbation_audit, truncation_audit, valid_samples,
};

fn load() -> Option<Panel> {
    let dir = common::real_dir()?;
    let t0 = Instant::now();
    let (p, report) = Panel::load_dir(&dir).unwrap();
    println!(
        "loaded {} stocks, {} sectors, {} days ({}..{}) in {:?}; dropped bad {} off-calendar {}",
        p.num_securities(),
        p.sectors.len(),
        p.num_days(),
        p.dates[0],
        p.dates[p.num_days() - 1],
        t0.elapsed(),
        report.total_dropped_bad(),
        report.total_off_calendar()
    );
    for r in report
        .symbols
        .iter()
        .filter(|r| r.missing_days > 0 || r.zero_volume > 0 || r.inconsistent_ohlc > 0)
    {
        println!("  {r:?}");
    }
    Some(p)
}

/// ~50 days: the lookback edge, then spread over the calendar, plus the last days.
fn audit_days(n: usize) -> Vec<usize> {
    let mut d = vec![0, 100, 249, 250, 251, 252, 253, 260, 300, 371, 372];
    d.extend((400..n).step_by((n - 400) / 36));
    d.extend([n - 3, n - 2, n - 1]);
    d.sort();
    d.dedup();
    d
}

#[test]
fn real_panel_smoke_counts() {
    let Some(p) = load() else {
        println!("no real data; skipped");
        return;
    };
    assert_eq!(p.num_securities(), 56);
    assert_eq!(p.sectors.len(), 9);
    let t0 = Instant::now();
    let f = compute_features(&p);
    println!(
        "features in {:?}: {} valid rows of {}",
        t0.elapsed(),
        f.num_valid(),
        f.valid.len()
    );
    let cfg = LabelConfig {
        horizon: 5,
        kappa: 0.0005,
        margin_mult: 0.0,
        stop_frac: 0.05,
    };
    let l = compute_labels(&p, &cfg).unwrap();
    let samples = valid_samples(&f, &l, 64);
    let mut counts = [0usize; 3];
    let mut stops = 0;
    for smp in &samples {
        counts[l.class_of(smp.security(), smp.day()).unwrap().id()] += 1;
        stops += l.stop_of(smp.security(), smp.day()) as usize;
    }
    let n = samples.len() as f64;
    println!(
        "h=5 kappa=5bp: labels {}, samples(W=64) {}, BUY {} ({:.1}%), SELL {} ({:.1}%), HOLD {} ({:.1}%), stop {:.1}%",
        l.num_existing(),
        samples.len(),
        counts[0],
        100.0 * counts[0] as f64 / n,
        counts[1],
        100.0 * counts[1] as f64 / n,
        counts[2],
        100.0 * counts[2] as f64 / n,
        100.0 * stops as f64 / n
    );
    let all = l.class_counts();
    println!(
        "all existing labels: BUY {} SELL {} HOLD {}",
        all[0], all[1], all[2]
    );
    for (m, name) in [(0.25, "m=0.25"), (0.5, "m=0.5")] {
        let lm = compute_labels(
            &p,
            &LabelConfig {
                margin_mult: m,
                ..cfg
            },
        )
        .unwrap();
        let c = lm.class_counts();
        let tot = (c[0] + c[1] + c[2]) as f64;
        println!(
            "  {name}: BUY {:.1}% SELL {:.1}% HOLD {:.1}%",
            100.0 * c[0] as f64 / tot,
            100.0 * c[1] as f64 / tot,
            100.0 * c[2] as f64 / tot
        );
    }
    // Every stock's rows become valid from day 251 (complete data).
    assert!((0..56).all(|s| !f.is_valid(s, 250) && f.is_valid(s, 251)));
    assert!(samples.len() > 300_000);
    // With m = 0 the HOLD band is only 2*kappa wide, so HOLD is rare (a few %).
    assert!(counts.iter().all(|&c| c > 0));
    assert!(counts[0] as f64 > 0.3 * n && counts[1] as f64 > 0.3 * n);
    assert_eq!(l.class_of(0, p.num_days() - 1), None);
    // Feature summary over the valid rows (train-like fit on everything).
    let norm = Normalizer::fit(&f, 0..p.num_days()).unwrap();
    for (k, name) in FEATURE_NAMES.iter().enumerate() {
        println!(
            "  {name:>10}: mean {:+.5} sd {:.5}",
            norm.mean[k], norm.sd[k]
        );
        assert!(norm.sd[k] > 1e-4, "{name} is degenerate");
    }
}

#[test]
fn real_panel_truncation_audit() {
    let Some(p) = load() else { return };
    let days = audit_days(p.num_days());
    println!("auditing {} days", days.len());
    let t0 = Instant::now();
    let mm = truncation_audit(&p, &days, compute_features);
    println!("truncation audit in {:?}", t0.elapsed());
    assert!(
        mm.is_empty(),
        "{} mismatches, first {:?}",
        mm.len(),
        &mm[..mm.len().min(5)]
    );
}

#[test]
fn real_panel_perturbation_and_label_audits() {
    let Some(p) = load() else { return };
    let days = audit_days(p.num_days());
    let t0 = Instant::now();
    let spread: Vec<usize> = days.iter().copied().step_by(3).collect();
    let mm = perturbation_audit(&p, &spread, 17, compute_features);
    assert!(
        mm.is_empty(),
        "{} mismatches, first {:?}",
        mm.len(),
        &mm[..mm.len().min(5)]
    );
    let mm = label_audit(&p, &LabelConfig::default(), &days, 5);
    assert!(
        mm.is_empty(),
        "{} mismatches, first {:?}",
        mm.len(),
        &mm[..mm.len().min(5)]
    );
    println!("perturbation + label audits in {:?}", t0.elapsed());
}
//! Look-ahead audits on synthetic panels, and injected leaks that the audits must catch.

use clm_data::features::col;
use clm_data::synthetic::generate;
use clm_data::{
    FeatureTensor, LabelConfig, Panel, PlantedSignal, SyntheticConfig, compute_features,
    label_audit, perturbation_audit, truncation_audit,
};

fn synth(missing_prob: f64) -> Panel {
    generate(&SyntheticConfig {
        seed: 11,
        num_days: 700,
        num_sectors: 2,
        stocks_per_sector: 3,
        missing_prob,
        signal: Some(PlantedSignal::default()),
    })
    .panel
}

/// Every day from 0 to the end in steps, plus the edges around the 252-day lookback.
fn audit_days(n: usize) -> Vec<usize> {
    let mut d: Vec<usize> = (0..n).step_by(9).collect();
    d.extend([250, 251, 252, 253, n - 2, n - 1]);
    d.sort();
    d.dedup();
    d
}

#[test]
fn features_pass_truncation_audit_on_synthetic() {
    for missing in [0.0, 0.01] {
        let p = synth(missing);
        let f = compute_features(&p);
        assert!(f.num_valid() > 0);
        let mm = truncation_audit(&p, &audit_days(p.num_days()), compute_features);
        assert!(
            mm.is_empty(),
            "missing {missing}: {:?}",
            &mm[..mm.len().min(5)]
        );
    }
}

#[test]
fn features_pass_perturbation_audit_on_synthetic() {
    let p = synth(0.01);
    let mm = perturbation_audit(&p, &audit_days(p.num_days()), 5, compute_features);
    assert!(mm.is_empty(), "{:?}", &mm[..mm.len().min(5)]);
}

#[test]
fn labels_pass_label_audit_on_synthetic() {
    let p = synth(0.01);
    for h in [1, 5, 20] {
        let c = LabelConfig {
            horizon: h,
            ..LabelConfig::default()
        };
        let mm = label_audit(&p, &c, &audit_days(p.num_days()), 9);
        assert!(mm.is_empty(), "h={h}: {:?}", &mm[..mm.len().min(5)]);
    }
}

/// r1 replaced by the *next* day's return where it exists.
fn leaky_next_close(p: &Panel) -> FeatureTensor {
    let mut f = compute_features(p);
    for s in 0..p.num_securities() {
        let x = &p.stocks[s];
        for t in 0..p.num_days() {
            if !f.is_valid(s, t) {
                continue;
            }
            if x.has(t + 1) {
                f.row_mut(s, t)[col::R1] = (x.close[t + 1] / x.close[t]).ln() as f32;
            } else {
                f.invalidate(s, t);
            }
        }
    }
    f
}

/// A feature centred by the whole-sample mean of r20 (the classic full-sample leak).
fn leaky_full_sample_mean(p: &Panel) -> FeatureTensor {
    let mut f = compute_features(p);
    let (mut sum, mut n) = (0.0f64, 0usize);
    for s in 0..f.num_securities {
        for t in 0..f.num_days {
            if f.is_valid(s, t) {
                sum += f.get(s, t, col::R20) as f64;
                n += 1;
            }
        }
    }
    let mean = (sum / n.max(1) as f64) as f32;
    for s in 0..f.num_securities {
        for t in 0..f.num_days {
            if f.is_valid(s, t) {
                f.row_mut(s, t)[col::R20] -= mean;
            }
        }
    }
    f
}

#[test]
fn injected_next_close_leak_is_caught() {
    let p = synth(0.0);
    let days = audit_days(p.num_days());
    let mm = truncation_audit(&p, &days, leaky_next_close);
    assert!(!mm.is_empty());
    // Truncation makes day t the last day, so the leaky row becomes invalid.
    assert!(mm.iter().all(|m| m.field == "valid" && m.day >= 251));
    let audited_valid = days
        .iter()
        .filter(|&&d| d >= 251 && d < p.num_days() - 1)
        .count();
    assert_eq!(mm.len(), audited_valid * p.num_securities());
    // The perturbation audit sees the value change itself.
    let mm = perturbation_audit(&p, &days, 1, leaky_next_close);
    assert!(mm.iter().any(|m| m.field == "r1"));
}

#[test]
fn injected_full_sample_leak_is_caught_by_truncation() {
    let p = synth(0.0);
    let mm = truncation_audit(&p, &audit_days(p.num_days()), leaky_full_sample_mean);
    assert!(mm.iter().any(|m| m.field == "r20"));
    assert!(mm.iter().all(|m| m.field == "r20"));
}

#[test]
fn injected_future_cross_section_leak_is_caught() {
    // xs_r20 computed from the next day's cross-section.
    let leaky = |p: &Panel| {
        let mut f = compute_features(p);
        let g = f.clone();
        for s in 0..f.num_securities {
            for t in 0..f.num_days {
                if f.is_valid(s, t) {
                    let next = if t + 1 < g.num_days && g.is_valid(s, t + 1) {
                        g.get(s, t + 1, col::XS_R20)
                    } else {
                        0.0
                    };
                    f.row_mut(s, t)[col::XS_R20] = next;
                }
            }
        }
        f
    };
    let p = synth(0.0);
    let mm = truncation_audit(&p, &audit_days(p.num_days()), leaky);
    assert!(mm.iter().any(|m| m.field == "xs_r20"));
}
//! Differential tests against the Lean `clmcheck` oracle (finance/lean/ClmVerify).
//!
//! Protocol: one command per stdin line; for each command the oracle prints its output
//! lines and then `end`. Commands used here:
//!
//! * `folds N scheme train_days first_test last_test val_days cal_days h e min_train_days
//!   nyears y1 c1 y2 c2 ...` → one `fold ...` line per emitted fold;
//! * `backtest n a1 .. an` → `pos ...` and `trade ...`.
//!
//! These tests are ignored by default (they need `lake build` in finance/lean/ClmVerify)
//! and fail loudly when the binary or fixtures are missing.

use std::io::Write;
use std::path::PathBuf;
use std::process::{Command, Stdio};

use clm_data::types::Action;
use clm_eval::backtest::{render_backtest, render_backtest_command};
use clm_eval::folds::{FoldConfig, Scheme, make_folds, render_folds, render_folds_command};
use rand::rngs::StdRng;
use rand::{Rng, SeedableRng};

fn lean_dir() -> PathBuf {
    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../lean/ClmVerify")
}

fn binary() -> PathBuf {
    let p = lean_dir().join(".lake/build/bin/clmcheck");
    assert!(
        p.is_file(),
        "Lean oracle binary not found at {} — run `lake build` in finance/lean/ClmVerify",
        p.display()
    );
    p
}

/// Run all commands through the oracle in one process; returns one output group per
/// command (lines before each `end`, trailing whitespace trimmed).
fn run_oracle(commands: &[String]) -> Vec<Vec<String>> {
    let mut child = Command::new(binary())
        .stdin(Stdio::piped())
        .stdout(Stdio::piped())
        .stderr(Stdio::piped())
        .spawn()
        .expect("spawn clmcheck");
    let mut stdin = child.stdin.take().expect("stdin");
    let input = commands.join("\n") + "\n";
    let writer = std::thread::spawn(move || {
        stdin
            .write_all(input.as_bytes())
            .expect("write to clmcheck");
        // dropping stdin closes it so the oracle sees EOF
    });
    let out = child.wait_with_output().expect("clmcheck output");
    writer.join().expect("writer thread");
    assert!(
        out.status.success(),
        "clmcheck failed: {}\n{}",
        out.status,
        String::from_utf8_lossy(&out.stderr)
    );
    groups(&String::from_utf8(out.stdout).expect("utf8"))
}

fn groups(text: &str) -> Vec<Vec<String>> {
    let mut all = Vec::new();
    let mut cur = Vec::new();
    for line in text.lines() {
        let line = line.trim_end();
        if line == "end" {
            all.push(std::mem::take(&mut cur));
        } else {
            cur.push(line.to_string());
        }
    }
    assert!(cur.is_empty(), "output ends without `end`: {cur:?}");
    all
}

/// Parse a `folds` command back into a calendar and config; `Err` if malformed (the
/// oracle must then answer with an `error` line).
fn parse_folds(cmd: &str) -> Result<(Vec<i32>, usize, FoldConfig), String> {
    let v: Vec<i64> = cmd
        .split_whitespace()
        .skip(1)
        .map(|x| x.parse().map_err(|_| format!("bad token {x}")))
        .collect::<Result<_, _>>()?;
    if v.len() < 11 {
        return Err("too few numbers".into());
    }
    let nonneg = |i: usize| -> Result<usize, String> {
        usize::try_from(v[i]).map_err(|_| format!("field {i} negative"))
    };
    let n = nonneg(0)?;
    let scheme = match v[1] {
        0 => Scheme::Expanding,
        1 => Scheme::Rolling {
            train_days: nonneg(2)?,
        },
        s => return Err(format!("bad scheme {s}")),
    };
    let cfg = FoldConfig {
        scheme,
        first_test_year: v[3] as i32,
        last_test_year: v[4] as i32,
        val_days: nonneg(5)?,
        cal_days: nonneg(6)?,
        horizon: nonneg(7)?,
        embargo: nonneg(8)?,
        min_train_days: nonneg(9)?,
    };
    let ny = nonneg(10)?;
    if v.len() != 11 + 2 * ny {
        return Err("wrong number of year runs".into());
    }
    let mut years = Vec::with_capacity(n);
    for k in 0..ny {
        let y = v[11 + 2 * k] as i32;
        if k > 0 && v[11 + 2 * k] <= v[9 + 2 * k] {
            return Err("years not increasing".into());
        }
        years.extend(std::iter::repeat_n(y, nonneg(12 + 2 * k)?));
    }
    if years.len() != n {
        return Err("year counts do not sum to N".into());
    }
    Ok((years, n, cfg))
}

fn parse_backtest(cmd: &str) -> Result<Vec<Action>, String> {
    let v: Vec<usize> = cmd
        .split_whitespace()
        .skip(1)
        .map(|x| x.parse().map_err(|_| format!("bad token {x}")))
        .collect::<Result<_, _>>()?;
    if v.is_empty() || v.len() != 1 + v[0] {
        return Err("wrong number of actions".into());
    }
    v[1..]
        .iter()
        .map(|&a| Action::from_id(a).ok_or(format!("bad action {a}")))
        .collect()
}

/// Rust's answer to a command: `None` for commands this crate does not implement,
/// `Some(Err)` for malformed ones.
fn rust_answer(cmd: &str) -> Option<Result<Vec<String>, String>> {
    match cmd.split_whitespace().next() {
        Some("folds") => {
            Some(parse_folds(cmd).map(|(years, n, cfg)| render_folds(&make_folds(&years, n, &cfg))))
        }
        Some("backtest") => Some(parse_backtest(cmd).map(|a| render_backtest(&a).to_vec())),
        _ => None,
    }
}

fn random_folds_command(rng: &mut StdRng) -> String {
    let y0 = rng.random_range(1995..2010);
    let nyears = rng.random_range(1..9);
    let mut years = Vec::new();
    for k in 0..nyears {
        let c = if rng.random_bool(0.1) {
            0
        } else {
            rng.random_range(1..40)
        };
        years.extend(std::iter::repeat_n(y0 + k, c));
    }
    let scheme = if rng.random_bool(0.5) {
        Scheme::Expanding
    } else {
        Scheme::Rolling {
            train_days: rng.random_range(0..80),
        }
    };
    let first = y0 + rng.random_range(-1..nyears + 1);
    let cfg = FoldConfig {
        scheme,
        first_test_year: first,
        last_test_year: first + rng.random_range(-1..nyears + 1),
        val_days: rng.random_range(0..15),
        cal_days: rng.random_range(0..15),
        horizon: rng.random_range(1..10),
        embargo: rng.random_range(0..6),
        min_train_days: rng.random_range(0..50),
    };
    render_folds_command(&years, years.len(), &cfg)
}

fn random_backtest_command(rng: &mut StdRng) -> String {
    let n = rng.random_range(0..30);
    let acts: Vec<Action> = (0..n)
        .map(|_| Action::from_id(rng.random_range(0..3)).unwrap())
        .collect();
    render_backtest_command(&acts)
}

fn compare(
    commands: &[String],
    lean: &[Vec<String>],
    rust: impl Fn(&str) -> Option<Result<Vec<String>, String>>,
) -> usize {
    assert_eq!(
        lean.len(),
        commands.len(),
        "oracle answered {} commands, sent {}",
        lean.len(),
        commands.len()
    );
    let mut compared = 0;
    for (cmd, got) in commands.iter().zip(lean) {
        match rust(cmd) {
            Some(Ok(want)) => assert_eq!(&want, got, "Rust and Lean disagree on `{cmd}`"),
            Some(Err(why)) => assert!(
                got.len() == 1 && got[0].starts_with("error"),
                "Rust rejects `{cmd}` ({why}) but Lean answered {got:?}"
            ),
            None => continue,
        }
        compared += 1;
    }
    compared
}

#[test]
#[ignore = "needs finance/lean/ClmVerify built (lake build)"]
fn random_commands_agree_with_lean() {
    let mut rng = StdRng::seed_from_u64(0xC1A5_0001);
    let mut cmds = Vec::new();
    for _ in 0..500 {
        cmds.push(random_folds_command(&mut rng));
    }
    for _ in 0..500 {
        cmds.push(random_backtest_command(&mut rng));
    }
    let lean = run_oracle(&cmds);
    let n = compare(&cmds, &lean, rust_answer);
    assert_eq!(n, 1000);
    // make sure the random folds are not all trivially empty
    let nonempty = lean[..500].iter().filter(|g| !g.is_empty()).count();
    assert!(
        nonempty > 100,
        "only {nonempty} folds commands emitted a fold"
    );
}

#[test]
#[ignore = "needs finance/lean/ClmVerify built (lake build)"]
fn lean_fixture_agrees_with_rust() {
    let dir = lean_dir().join("test");
    let cases_path = dir.join("cases.txt");
    let expected_path = dir.join("expected.txt");
    let cases = std::fs::read_to_string(&cases_path)
        .unwrap_or_else(|e| panic!("cannot read {}: {e}", cases_path.display()));
    let expected = std::fs::read_to_string(&expected_path)
        .unwrap_or_else(|e| panic!("cannot read {}: {e}", expected_path.display()));
    let cmds: Vec<String> = cases
        .lines()
        .map(str::trim)
        .filter(|l| !l.is_empty() && !l.starts_with('#'))
        .map(String::from)
        .collect();
    let want = groups(&expected);
    let n = compare(&cmds, &want, rust_answer);
    assert!(n > 0, "the fixture holds no folds/backtest command");
    // and the binary reproduces its own fixture
    if lean_dir().join(".lake/build/bin/clmcheck").is_file() {
        assert_eq!(
            run_oracle(&cmds),
            want,
            "clmcheck output differs from expected.txt"
        );
    }
}

#[test]
fn command_rendering_round_trips() {
    // Not ignored: the renderer and the parser above agree with each other.
    let mut rng = StdRng::seed_from_u64(5);
    for _ in 0..200 {
        let c = random_folds_command(&mut rng);
        let (years, n, cfg) = parse_folds(&c).unwrap();
        assert_eq!(render_folds_command(&years, n, &cfg), c);
        let b = random_backtest_command(&mut rng);
        assert_eq!(render_backtest_command(&parse_backtest(&b).unwrap()), b);
    }
    assert_eq!(
        groups("fold a\nfold b\nend\nend\npos 1\ntrade 1 \nend\n"),
        vec![
            vec!["fold a".to_string(), "fold b".to_string()],
            vec![],
            vec!["pos 1".to_string(), "trade 1".to_string()]
        ]
    );
}

