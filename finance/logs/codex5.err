//! The walk-forward CV runner.
//!
//! Per fold: normalise on training days, purge, run the leakage guard. Per model:
//! train every hyperparameter candidate on `train`, early-stop and select on the
//! `val` log loss; fit the calibrator and choose the decision threshold on `cal`;
//! predict every input-valid `test` day. Nothing fitted ever sees `test`.
//! Outputs go to `<out>/fold_<year>/<model>/` and resume: a model whose
//! `model.json` exists (written last) is skipped.

use std::collections::HashMap;
use std::io::Write;
use std::path::{Path, PathBuf};
use std::time::Instant;

use clm_data::{Action, SampleIndex, read_predictions};
use clm_eval::backtest::{backtest_metrics, run_backtest};
use clm_eval::calibration::{CalibrationMethod, Calibrator};
use clm_eval::folds::{Fold, Segment, SegmentKind, make_folds, render_folds_line};
use clm_eval::oof::{FoldMetadata, OofRecord, read_json, write_json, write_oof_parquet};
use clm_eval::purging::check_folds_disjoint;
use clm_model::{
    DecisionModel, FitReport, PanelSource, Split, SplitPredictions, fit, predict_split, softmax3,
};
use mamba3::backend::Device;
use mamba3::backends::Auto;
use mamba3::train::checkpoint::Checkpoint;
use serde::{Deserialize, Serialize};

use crate::config::anyhow_like::{Result, err, wrap};
use crate::config::{ExperimentConfig, GridPoint, ModelSpec};
use crate::data::{Dataset, FoldData, prepare_fold};

type R = Auto;

/// What one model did on one fold.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct FoldModelResult {
    /// Model name.
    pub model: String,
    /// Test year.
    pub test_year: i32,
    /// Candidates tried and their validation log loss.
    pub candidates: Vec<(GridPoint, f64)>,
    /// Index of the kept candidate.
    pub chosen: usize,
    /// Seed of the kept candidate.
    pub seed: u64,
    /// Training report of the kept candidate (internal models).
    pub fit: Option<FitReport>,
    /// Calibrator fitted on `cal` (applied to the test scores).
    pub calibrator: Calibrator,
    /// Decision threshold chosen on `cal`.
    pub tau: f64,
    /// Calibration-segment Sharpe per threshold candidate.
    pub tau_sharpe: Vec<(f64, f64)>,
    /// Calibration-segment log loss before and after calibration.
    pub cal_nll: (f64, f64),
    /// Number of parameters (internal models).
    pub num_params: usize,
    /// Seconds spent on this model and fold.
    pub seconds: f64,
}

/// The decision rule feeding the C5 policy: trade on the calibrated edge
/// `p_buy - p_sell`. Above `tau` be long (BUY), below `-tau` be flat (SELL),
/// otherwise keep the position (HOLD). A large HOLD probability shrinks the edge
/// rather than vetoing the trade: with HOLD as the most frequent class, a veto
/// left every model holding whatever it bought first, i.e. buy and hold.
pub fn decide(p: [f32; 3], tau: f64) -> Action {
    let edge = p[0] as f64 - p[1] as f64;
    if edge > tau {
        Action::Buy
    } else if edge < -tau {
        Action::Sell
    } else {
        Action::Hold
    }
}

fn git_commit() -> String {
    let rev = std::process::Command::new("git")
        .args(["rev-parse", "HEAD"])
        .output()
        .ok()
        .filter(|o| o.status.success())
        .map(|o| String::from_utf8_lossy(&o.stdout).trim().to_string())
        .unwrap_or_else(|| "unknown".into());
    let dirty = std::process::Command::new("git")
        .args(["status", "--porcelain", "--untracked-files=no"])
        .output()
        .ok()
        .is_some_and(|o| !o.stdout.is_empty());
    if dirty { format!("{rev}+dirty") } else { rev }
}

/// Run every fold and model of `cfg` into `out`.
pub fn run(cfg: &ExperimentConfig, out: &Path, only: &[String], years: &[i32]) -> Result<()> {
    std::fs::create_dir_all(out).map_err(wrap("creating output dir"))?;
    let device = Device::<R>::default();
    let ds = Dataset::load(cfg)?;
    let n = ds.dates.len();
    let fold_cfg = cfg.fold_config();
    let folds = make_folds(&ds.years, n, &fold_cfg);
    check_folds_disjoint(&folds).map_err(|e| err(format!("folds overlap: {e}")))?;
    let commit = git_commit();
    let signature = cfg.signature(&ds.version);
    // A run directory belongs to one signature: never resume with other config,
    // data or code (the report would mix them).
    if let Ok(prev) = read_json::<serde_json::Value>(out.join("run.json")) {
        let old = prev.get("signature").and_then(|v| v.as_str()).unwrap_or("");
        if old != signature {
            return Err(err(format!(
                "{} holds a run with signature {old:?}, this one is {signature:?} (config, data or source changed); use a new --out",
                out.display()
            )));
        }
    }
    let run_meta = serde_json::json!({
        "signature": signature,
        "source_hash": env!("CLM_SOURCE_HASH"),
        "config": cfg,
        "dataset_version": ds.version,
        "git_commit": commit,
        "software_version": env!("CARGO_PKG_VERSION"),
        "device": format!("{:?}", device.inner()),
        "folds": folds.iter().map(render_folds_line).collect::<Vec<_>>(),
        "class_counts": ds.labels.class_counts(),
    });
    write_json(out.join("run.json"), &run_meta).map_err(wrap("run.json"))?;
    eprintln!("{} folds; dataset {}; commit {}", folds.len(), ds.version, commit);

    for (k, fold) in folds.iter().enumerate() {
        if !years.is_empty() && !years.contains(&fold.test_year) {
            continue;
        }
        let fdir = out.join(format!("fold_{}", fold.test_year));
        std::fs::create_dir_all(&fdir).map_err(wrap("fold dir"))?;
        let fd = prepare_fold(&ds, fold, cfg)?;
        let meta = FoldMetadata::new(k, fold, &fold_cfg, &ds.dates, cfg.seed, &ds.version, &commit);
        write_json(fdir.join("fold.json"), &meta).map_err(wrap("fold.json"))?;
        write_json(fdir.join("normalizer.json"), &fd.normalizer).map_err(wrap("normalizer.json"))?;
        let sizes: HashMap<String, usize> = fd.splits.iter().map(|(k, v)| (format!("{k:?}"), v.len())).collect();
        write_json(fdir.join("splits.json"), &sizes).map_err(wrap("splits.json"))?;
        eprintln!("fold {} ({}): {:?}", k, fold.test_year, sizes);
        for spec in &cfg.models {
            if !only.is_empty() && !only.contains(&spec.name) {
                continue;
            }
            let mdir = fdir.join(&spec.name);
            if mdir.join("model.json").exists() {
                eprintln!("  {}: done, skipping", spec.name);
                continue;
            }
            std::fs::create_dir_all(&mdir).map_err(wrap("model dir"))?;
            let started = Instant::now();
            let (cal_preds, test_preds, mut result) = if spec.is_internal() {
                train_model(cfg, spec, &ds, fold, k, &fd, &mdir, &device)?
            } else {
                external_model(spec, fold, &fd, &crate::data::fold_manifest(&ds, fold, &fd))?
            };
            finish_model(cfg, &ds, fold, k, &fd, &cal_preds, &test_preds, &mut result, &mdir)?;
            result.seconds = started.elapsed().as_secs_f64();
            write_json(mdir.join("model.json"), &result).map_err(wrap("model.json"))?;
            eprintln!(
                "  {}: chosen {:?} val_nll {:.4} cal_nll {:.4}->{:.4} tau {} ({:.0}s)",
                spec.name,
                result.candidates[result.chosen].0,
                result.candidates[result.chosen].1,
                result.cal_nll.0,
                result.cal_nll.1,
                result.tau,
                result.seconds
            );
        }
    }
    Ok(())
}

/// Predictions of one split, with the samples they belong to.
pub struct Preds {
    /// Samples in prediction order.
    pub samples: Vec<SampleIndex>,
    /// Raw scores (logits).
    pub scores: Vec<[f32; 3]>,
    /// Predicted vol-scaled return.
    pub ret: Option<Vec<f32>>,
}

#[allow(clippy::too_many_arguments)]
fn train_model(
    cfg: &ExperimentConfig,
    spec: &ModelSpec,
    ds: &Dataset,
    fold: &Fold,
    k: usize,
    fd: &FoldData,
    mdir: &Path,
    device: &Device<R>,
) -> Result<(Preds, Preds, FoldModelResult)> {
    let nf = ds.features.num_features;
    let mut best: Option<(f64, usize, u64, DecisionModel<R, f32>, FitReport)> = None;
    let mut candidates = Vec::new();
    let mut log = std::fs::File::create(mdir.join("train_log.jsonl")).map_err(wrap("train log"))?;
    for (gi, g) in spec.candidates().iter().enumerate() {
        // The same seed for every model of a fold and candidate index: differences
        // between models are not differences between seeds.
        let seed = cfg
            .seed
            .wrapping_add(1000 * k as u64)
            .wrapping_add(gi as u64)
            .wrapping_add(1_000_003 * spec.seed_offset);
        let model = DecisionModel::<R, f32>::new(&spec.model_config(cfg, nf, g, seed), device)
            .map_err(wrap("building model"))?;
        let mut src = PanelSource::new(&fd.normalized, &ds.labels, fd.splits.clone(), spec.source_config(cfg, seed));
        let report = fit(&model, &mut src, &spec.train_config(cfg, g), device, &mut |p| {
            let line = serde_json::json!({"candidate": gi, "point": p});
            let _ = writeln!(log, "{line}");
        })
        .map_err(|e| err(format!("{} fold {} candidate {gi}: {e}", spec.name, fold.test_year)))?;
        candidates.push((g.clone(), report.best_val_nll));
        if best.as_ref().is_none_or(|b| report.best_val_nll < b.0) {
            best = Some((report.best_val_nll, gi, seed, model, report));
        }
    }
    let (_, chosen, seed, model, report) = best.expect("at least one candidate");
    Checkpoint::capture(&model, report.best_step)
        .with_metadata(serde_json::json!({"model": spec.name, "test_year": fold.test_year, "seed": seed, "config": model.config()}))
        .save(mdir.join("model.ckpt"))
        .map_err(wrap("checkpoint"))?;
    let src = PanelSource::new(&fd.normalized, &ds.labels, fd.splits.clone(), spec.source_config(cfg, seed));
    let eb = cfg.train.eval_batch;
    let to_preds = |split: Split, p: SplitPredictions| Preds {
        samples: src.samples(split).to_vec(),
        scores: p.scores,
        ret: p.ret,
    };
    let cal = to_preds(Split::Cal, predict_split(&model, &src, Split::Cal, eb, device).map_err(wrap("predict cal"))?);
    let test = to_preds(Split::Test, predict_split(&model, &src, Split::Test, eb, device).map_err(wrap("predict test"))?);
    let num_params = model.num_params();
    Ok((
        cal,
        test,
        FoldModelResult {
            model: spec.name.clone(),
            test_year: fold.test_year,
            candidates,
            chosen,
            seed,
            fit: Some(report),
            calibrator: Calibrator::Identity,
            tau: 0.0,
            tau_sharpe: vec![],
            cal_nll: (f64::NAN, f64::NAN),
            num_params,
            seconds: 0.0,
        },
    ))
}

fn external_model(
    spec: &ModelSpec,
    fold: &Fold,
    fd: &FoldData,
    manifest: &serde_json::Value,
) -> Result<(Preds, Preds, FoldModelResult)> {
    let dir: PathBuf = spec
        .external_dir
        .clone()
        .expect("validated")
        .join(format!("fold_{}", fold.test_year));
    // Provenance: the external program must echo this fold's manifest exactly.
    let meta: serde_json::Value = read_json(dir.join("meta.json")).map_err(wrap("external meta.json"))?;
    if meta.get("manifest") != Some(manifest) {
        return Err(err(format!(
            "{}: {} was not produced from this run's data/fold/splits (manifest mismatch)",
            spec.name,
            dir.display()
        )));
    }
    let load = |split: Split, file: &str| -> Result<Preds> {
        let p = read_predictions(dir.join(file)).map_err(wrap(file))?;
        let by_key: HashMap<(u32, u32), usize> = p.s.iter().zip(&p.t).enumerate().map(|(i, (&s, &t))| ((s, t), i)).collect();
        let samples = fd.splits[&split].clone();
        if p.s.len() != samples.len() {
            return Err(err(format!(
                "{}: {file} has {} rows, the split has {} samples",
                spec.name,
                p.s.len(),
                samples.len()
            )));
        }
        let mut scores = Vec::with_capacity(samples.len());
        let mut ret = p.pred_ret.as_ref().map(|_| Vec::with_capacity(samples.len()));
        for smp in &samples {
            let i = *by_key.get(&(smp.s, smp.t)).ok_or_else(|| {
                err(format!("{}: {file} lacks sample s={} t={}", spec.name, smp.s, smp.t))
            })?;
            scores.push(p.probs[i].map(|v| (v.max(1e-9)).ln() as f32));
            if let (Some(r), Some(src)) = (ret.as_mut(), p.pred_ret.as_ref()) {
                r.push(src[i] as f32);
            }
        }
        Ok(Preds { samples, scores, ret })
    };
    let cal = load(Split::Cal, "pred_cal.parquet")?;
    let test = load(Split::Test, "pred_test.parquet")?;
    let candidates: Vec<(GridPoint, f64)> = meta
        .get("candidate_val_nll")
        .and_then(|v| v.as_array())
        .map(|a| a.iter().map(|x| (GridPoint::default(), x.as_f64().unwrap_or(f64::NAN))).collect())
        .ok_or_else(|| err(format!("{}: meta.json lacks candidate_val_nll", spec.name)))?;
    let chosen = meta.get("candidate").and_then(|v| v.as_u64()).unwrap_or(0) as usize;
    Ok((
        cal,
        test,
        FoldModelResult {
            model: spec.name.clone(),
            test_year: fold.test_year,
            candidates,
            chosen,
            seed: 0,
            fit: None,
            calibrator: Calibrator::Identity,
            tau: 0.0,
            tau_sharpe: vec![],
            cal_nll: (f64::NAN, f64::NAN),
            num_params: 0,
            seconds: 0.0,
        },
    ))
}

/// Calibrate and choose the threshold on `cal`, write the out-of-fold records.
#[allow(clippy::too_many_arguments)]
fn finish_model(
    cfg: &ExperimentConfig,
    ds: &Dataset,
    fold: &Fold,
    k: usize,
    fd: &FoldData,
    cal: &Preds,
    test: &Preds,
    result: &mut FoldModelResult,
    mdir: &Path,
) -> Result<()> {
    let cal_labels: Vec<u8> = cal
        .samples
        .iter()
        .map(|s| ds.labels.class_of(s.security(), s.day()).expect("cal samples are labelled").id() as u8)
        .collect();
    let calibrator = Calibrator::fit(CalibrationMethod::Temperature, &cal.scores, &cal_labels);
    let raw_p: Vec<[f32; 3]> = cal.scores.iter().map(|s| softmax3(*s, 1.0)).collect();
    let cal_p = calibrator.apply(&cal.scores);
    result.cal_nll = (
        clm_eval::metrics::log_loss(&raw_p, &cal_labels),
        clm_eval::metrics::log_loss(&cal_p, &cal_labels),
    );
    // Threshold: the backtest on the kept part of `cal` only, so no price it reads
    // lies in the test segment (kept: t + 1 + h + e < test start).
    let keep = fold.kept(SegmentKind::Cal);
//! Aggregate a CV run: prediction quality, calibration, trading after costs,
//! cost sensitivity, regimes, and paired comparisons with uncertainty.

use std::collections::BTreeMap;
use std::fmt::Write as _;
use std::path::Path;

use clm_data::{Action, FEATURE_NAMES};
use clm_eval::backtest::{BacktestMetrics, DailySeries, backtest_metrics, buy_and_hold, run_backtest};
use clm_eval::calibration::{CalibrationMethod, Calibrator};
use clm_eval::folds::{Fold, make_folds};
use clm_eval::metrics::{ClassificationMetrics, IcSummary, classification_metrics, rank_ic, regression_metrics};
use clm_eval::oof::{OofRecord, read_json, read_oof_parquet, write_json};
use clm_eval::statistics::{
    BootstrapConfig, PairedBootstrap, SeriesBootstrap, YearComparison, bootstrap_series, paired_bootstrap_series,
    paired_by_year, paired_sharpe_by_year, regime_flags, regime_split,
};
use serde::Serialize;

use crate::config::ExperimentConfig;
use crate::config::anyhow_like::{Result, err, wrap};
use crate::cv::{FoldModelResult, decide};
use crate::data::Dataset;

/// Everything reported for one model.
#[derive(Debug, Clone, Serialize)]
pub struct ModelReport {
    /// Model name.
    pub model: String,
    /// Folds found.
    pub folds: Vec<i32>,
    /// Prediction quality with the raw softmax.
    pub raw: ClassificationMetrics,
    /// Prediction quality after the per-fold calibration.
    pub calibrated: ClassificationMetrics,
    /// Test log loss / Brier / ECE per calibration method (refitted on each fold's `cal`).
    pub calibration_methods: Vec<(String, f64, f64, f64)>,
    /// Daily rank IC of `p_buy - p_sell` against the forward return.
    pub ic: IcSummary,
    /// RMSE of the predicted vol-scaled return, if the model has the head.
    pub ret_rmse: Option<f64>,
    /// Trading metrics at the configured cost, primary policy (fixed tau).
    pub trading: BacktestMetrics,
    /// Trading metrics with each fold's tau tuned on its calibration segment.
    pub trading_tuned_tau: BacktestMetrics,
    /// Bootstrap intervals of the daily returns.
    pub bootstrap: SeriesBootstrap,
    /// Trading metrics per one-way cost (bps).
    pub costs: Vec<(f64, BacktestMetrics)>,
    /// High / low market-volatility regimes.
    pub regimes: Option<(BacktestMetrics, BacktestMetrics)>,
    /// Sharpe per test year.
    pub yearly_sharpe: Vec<(i32, f64)>,
    /// Action shares on test days under the primary policy (BUY, SELL, HOLD).
    pub action_shares: [f64; 3],
    /// Mean decision threshold chosen on `cal`.
    pub mean_tau: f64,
    /// Mean training seconds per fold.
    pub mean_seconds: f64,
    /// Parameters (last fold).
    pub num_params: usize,
    /// Mean training samples per second.
    pub samples_per_second: f64,
    /// Largest tensor-owned device memory of a fold's fit, MB (0 when the run
    /// predates the measurement).
    pub peak_device_mb: f64,
}

/// A paired comparison against the reference model.
#[derive(Debug, Clone, Serialize)]
pub struct Comparison {
    /// Model.
    pub model: String,
    /// Reference.
    pub reference: String,
    /// Paired stationary bootstrap of the daily returns.
    pub bootstrap: PairedBootstrap,
    /// Per-year Sharpe.
    pub yearly_sharpe: YearComparison,
    /// Per-year calibrated log loss (lower is better).
    pub yearly_log_loss: YearComparison,
}

struct Loaded {
    results: Vec<FoldModelResult>,
    test: Vec<Vec<OofRecord>>,
    cal: Vec<Vec<OofRecord>>,
    folds: Vec<Fold>,
}

fn load_model(run: &Path, name: &str, folds: &[Fold]) -> Option<Loaded> {
    let mut out = Loaded {
        results: vec![],
        test: vec![],
        cal: vec![],
        folds: vec![],
    };
    for f in folds {
        let d = run.join(format!("fold_{}", f.test_year)).join(name);
        let Ok(result) = read_json::<FoldModelResult>(d.join("model.json")) else {
            continue;
        };
        let (Ok(test), Ok(cal)) = (read_oof_parquet(d.join("oof_test.parquet")), read_oof_parquet(d.join("oof_cal.parquet"))) else {
            continue;
        };
        out.results.push(result);
        out.test.push(test);
        out.cal.push(cal);
        out.folds.push(f.clone());
    }
    (!out.results.is_empty()).then_some(out)
}

/// The threshold a backtest uses: fixed for every model (primary), or the one
/// each fold chose on its calibration segment (secondary).
#[derive(Clone, Copy)]
enum Tau {
    Fixed(f64),
    Tuned,
}

fn backtest_folds(
    ds: &Dataset,
    opens: &[Vec<f64>],
    m: &Loaded,
    kappa: f64,
    tau: Tau,
) -> Result<(DailySeries, [usize; 3])> {
    let ns = ds.panel.stocks.len();
    let mut parts = Vec::new();
    let mut counts = [0usize; 3];
    for ((fold, recs), res) in m.folds.iter().zip(&m.test).zip(&m.results) {
        let mut decisions = vec![vec![None; fold.test.len()]; ns];
        for r in recs {
            let t = r.t as usize;
            if fold.test.contains(t) {
                let tau = match tau {
                    Tau::Fixed(v) => v,
                    Tau::Tuned => res.tau,
                };
                decisions[r.s as usize][t - fold.test.start] = Some(decide(r.calibrated, tau));
            }
        }
        // Every security x test day, an absent prediction (invalid input) is HOLD.
        for row in &decisions {
            for d in row {
                counts[d.unwrap_or(Action::Hold).id()] += 1;
            }
        }
        let bt = run_backtest(opens, fold.test, ds.dates.len(), &decisions, kappa).map_err(wrap("backtest"))?;
        parts.push(bt.daily);
    }
    Ok((DailySeries::concat(&parts).map_err(wrap("concat"))?, counts))
}

fn market_rv(ds: &Dataset) -> Vec<f64> {
    let f = FEATURE_NAMES.iter().position(|n| *n == "mkt_rv20").expect("mkt_rv20 feature");
    (0..ds.dates.len())
        .map(|t| {
            (0..ds.features.num_securities)
                .find(|&s| ds.features.is_valid(s, t))
                .map_or(f64::NAN, |s| ds.features.get(s, t, f) as f64)
        })
        .collect()
}

/// Build the report for `run` into `run/report.{json,md}`. The run must have been
/// made with this config and data; a different source version is allowed (report
/// code changes do not change stored predictions) but recorded. Every configured
/// model must have results unless `allow_partial`.
pub fn run(cfg: &ExperimentConfig, run: &Path, allow_partial: bool) -> Result<()> {
    let ds = Dataset::load(cfg)?;
    let meta: serde_json::Value = read_json(run.join("run.json")).map_err(wrap("run.json"))?;
    let run_cfg: ExperimentConfig = serde_json::from_value(meta.get("config").cloned().unwrap_or_default())
        .map_err(wrap("run.json config"))?;
    let same_cfg = serde_json::to_value(&run_cfg).ok() == serde_json::to_value(cfg).ok();
    if !same_cfg || meta.get("dataset_version").and_then(|v| v.as_str()) != Some(ds.version.as_str()) {
        return Err(err(format!(
            "{} was produced with another config or dataset; report it with the config it was run with",
            run.display()
        )));
    }
    let run_source = meta.get("source_hash").and_then(|v| v.as_str()).unwrap_or("unknown").to_string();
    if run_source != env!("CLM_SOURCE_HASH") {
        eprintln!(
            "note: predictions were produced by source {run_source}, this report by {}",
            env!("CLM_SOURCE_HASH")
        );
    }
    let opens = ds.opens();
    let folds = make_folds(&ds.years, ds.dates.len(), &cfg.fold_config());
    let rv = market_rv(&ds);
    // Daily returns are reported on the accrual day `t + 1`; years are those of the
    // decision day `t`, so a test year's last decision stays in its year.
    let decision_year: Vec<i32> = (0..ds.years.len()).map(|d| ds.years[d.saturating_sub(1)]).collect();
    let boot = BootstrapConfig::default();
    let mut reports = Vec::new();
    let mut series: BTreeMap<String, DailySeries> = BTreeMap::new();
    let mut yearly_ll: BTreeMap<String, BTreeMap<i32, f64>> = BTreeMap::new();
    // Every table covers the same test years: the folds all reported models finished.
    let mut loaded = Vec::new();
    for spec in &cfg.models {
        match load_model(run, &spec.name, &folds) {
            Some(m) => loaded.push((spec, m)),
            None => {
                if !allow_partial {
                    return Err(err(format!("{}: no finished folds (pass --allow-partial to report without it)", spec.name)));
                }
                eprintln!("{}: no finished folds, left out of the report", spec.name);
            }
        }
    }
    let common: Vec<i32> = folds
        .iter()
        .map(|f| f.test_year)
        .filter(|y| loaded.iter().all(|(_, m)| m.results.iter().any(|r| r.test_year == *y)))
        .collect();
    if common.is_empty() {
        return Err(err("the reported models share no finished fold"));
    }
    for (spec, m) in &mut loaded {
        let before = m.results.len();
        let keep: Vec<bool> = m.results.iter().map(|r| common.contains(&r.test_year)).collect();
        retain_by(&mut m.results, &keep);
        retain_by(&mut m.test, &keep);
        retain_by(&mut m.cal, &keep);
        retain_by(&mut m.folds, &keep);
        if m.results.len() < before {
            eprintln!("{}: {} finished folds outside the common set left out", spec.name, before - m.results.len());
        }
    }
    let excluded: Vec<i32> = folds.iter().map(|f| f.test_year).filter(|y| !common.contains(y)).collect();
    for (spec, m) in loaded {
        let labelled: Vec<&OofRecord> = m.test.iter().flatten().filter(|r| r.label.is_some()).collect();
        let labels: Vec<u8> = labelled.iter().map(|r| r.label.unwrap()).collect();
        let raw_p: Vec<[f32; 3]> = labelled.iter().map(|r| r.probs).collect();
        let cal_p: Vec<[f32; 3]> = labelled.iter().map(|r| r.calibrated).collect();
        let raw = classification_metrics(&raw_p, &labels);
        let calibrated = classification_metrics(&cal_p, &labels);
        // Calibration methods, each refitted per fold on that fold's `cal` logits.
        let mut calibration_methods = Vec::new();
        for (name, method) in [
            ("none", CalibrationMethod::Identity),
            ("temperature", CalibrationMethod::Temperature),
            ("vector", CalibrationMethod::Vector),
            ("isotonic", CalibrationMethod::Isotonic),
        ] {
            let mut p_all = Vec::new();
            let mut l_all = Vec::new();
            for (cal, test) in m.cal.iter().zip(&m.test) {
                let cl: Vec<[f32; 3]> = cal.iter().map(|r| r.logits).collect();
                let cy: Vec<u8> = cal.iter().map(|r| r.label.expect("cal is labelled")).collect();
                let c = Calibrator::fit(method, &cl, &cy);
                for r in test.iter().filter(|r| r.label.is_some()) {
                    p_all.push(c.apply_row(&r.logits).map(|v| v as f32));
                    l_all.push(r.label.unwrap());
                }
            }
            let cm = classification_metrics(&p_all, &l_all);
            calibration_methods.push((name.to_string(), cm.log_loss, cm.brier, cm.ece));
        }
        let ic = rank_ic(
            &labelled.iter().map(|r| r.t).collect::<Vec<_>>(),
            &labelled.iter().map(|r| (r.calibrated[0] - r.calibrated[1]) as f64).collect::<Vec<_>>(),
            &labelled.iter().map(|r| r.fwd_ret as f64).collect::<Vec<_>>(),
        );
        let ret_rmse = labelled.first().and_then(|r| r.pred_ret).map(|_| {
            let pred: Vec<f64> = labelled.iter().map(|r| r.pred_ret.unwrap_or(0.0) as f64).collect();
            let target: Vec<f64> = labelled
                .iter()
                .map(|r| ds.labels.vol_ret_of(r.s as usize, r.t as usize).clamp(-5.0, 5.0))
                .collect();
            regression_metrics(&pred, &target).rmse
        });
        let primary = Tau::Fixed(cfg.policy_tau);
        let (daily, action_counts) = backtest_folds(&ds, &opens, &m, cfg.kappa(), primary)?;
        let tuned = backtest_metrics(&backtest_folds(&ds, &opens, &m, cfg.kappa(), Tau::Tuned)?.0);
        let trading = backtest_metrics(&daily);
        let bootstrap = bootstrap_series(&daily.ret, &boot).map_err(wrap("bootstrap"))?;
        let mut costs = Vec::new();
        for bps in [0.0, 2.5, 5.0, 10.0, 20.0] {
            costs.push((bps, backtest_metrics(&backtest_folds(&ds, &opens, &m, bps * 1e-4, primary)?.0)));
        }
        // Regimes: market rv20 at the decision day against the median over each
        // fold's training days (point in time).
        let mut flags = Vec::new();
        for (fold, part) in m.folds.iter().zip(split_by_fold(&daily, &m.folds)) {
            let train_rv: Vec<f64> = fold.train.days().map(|t| rv[t]).filter(|v| v.is_finite()).collect();
            let decision_rv: Vec<f64> = part.iter().map(|&d| rv[d - 1]).map(|v| if v.is_finite() { v } else { 0.0 }).collect();
            match regime_flags(&decision_rv, &train_rv) {
                Ok((_, f)) => flags.extend(f),
                Err(_) => flags.extend(std::iter::repeat_n(false, part.len())),
            }
        }
        let regimes = regime_split(&daily, &flags).ok().map(|r| (r.high, r.low));
        let mut by_year: BTreeMap<i32, Vec<f64>> = BTreeMap::new();
        for (d, r) in daily.day.iter().zip(&daily.ret) {
            by_year.entry(decision_year[*d]).or_default().push(*r);
        }
        let yearly_sharpe = by_year
            .iter()
            .map(|(y, r)| (*y, clm_eval::backtest::sharpe(r)))
            .collect();
        let mut ll: BTreeMap<i32, f64> = BTreeMap::new();
        for (res, test) in m.results.iter().zip(&m.test) {
            let l: Vec<&OofRecord> = test.iter().filter(|r| r.label.is_some()).collect();
            let p: Vec<[f32; 3]> = l.iter().map(|r| r.calibrated).collect();
            let y: Vec<u8> = l.iter().map(|r| r.label.unwrap()).collect();
            ll.insert(res.test_year, clm_eval::metrics::log_loss(&p, &y));
        }
        yearly_ll.insert(spec.name.clone(), ll);
        let shares = action_counts.map(|c| c as f64);
        let total: f64 = shares.iter().sum();
        let report = ModelReport {
            model: spec.name.clone(),
            folds: m.results.iter().map(|r| r.test_year).collect(),
            raw,
            calibrated,
            calibration_methods,
            ic,
            ret_rmse,
            trading,
            trading_tuned_tau: tuned,
            bootstrap,
            costs,
            regimes,
            yearly_sharpe,
            action_shares: shares.map(|s| s / total.max(1.0)),
            mean_tau: m.results.iter().map(|r| r.tau).sum::<f64>() / m.results.len() as f64,
            mean_seconds: m.results.iter().map(|r| r.seconds).sum::<f64>() / m.results.len() as f64,
            num_params: m.results.last().map_or(0, |r| r.num_params),
            samples_per_second: {
                let v: Vec<f64> = m.results.iter().filter_map(|r| r.fit.as_ref().map(|f| f.samples_per_second)).collect();
                if v.is_empty() { 0.0 } else { v.iter().sum::<f64>() / v.len() as f64 }
            },
            peak_device_mb: m
                .results
                .iter()
                .filter_map(|r| r.fit.as_ref().map(|f| f.peak_device_bytes as f64 / 1e6))
                .fold(0.0, f64::max),
        };
        eprintln!(
            "{}: {} folds, cal log loss {:.4}, Sharpe {:.2}",
            report.model,
            report.folds.len(),
            report.calibrated.log_loss,
            report.trading.sharpe
        );
        series.insert(spec.name.clone(), daily);
        reports.push(report);
    }
    if reports.is_empty() {
        return Err(err("no model has finished folds"));
    }
    // Buy and hold over the reference's test days.
    let reference = cfg.reference.clone();
    let bh = {
        let mut parts = Vec::new();
        for f in &folds {
            if reports.iter().any(|r| r.model == reference && r.folds.contains(&f.test_year)) {
//! The dataset of one experiment and the per-fold sample sets.

use std::collections::HashMap;

use clm_data::{FeatureTensor, Labels, Normalizer, Panel, SampleIndex, compute_features, compute_labels};
use clm_eval::folds::{Fold, SegmentKind};
use clm_eval::purging::{check_no_leakage, split_samples};
use clm_model::{Split, input_valid};

use crate::config::ExperimentConfig;
use crate::config::anyhow_like::{Result, err, wrap};

/// Panel, raw features and labels.
pub struct Dataset {
    /// Bars.
    pub panel: Panel,
    /// Raw (un-normalised) features.
    pub features: FeatureTensor,
    /// Labels.
    pub labels: Labels,
    /// `yyyy-mm-dd` per day.
    pub dates: Vec<String>,
    /// Year per day.
    pub years: Vec<i32>,
    /// A fingerprint of the bars (symbol, first/last date, row count, sum of closes).
    pub version: String,
}

impl Dataset {
    /// Load bars and compute features and labels.
    pub fn load(cfg: &ExperimentConfig) -> Result<Self> {
        let (panel, report) = Panel::load_dir(&cfg.bars_dir).map_err(wrap("loading bars"))?;
        eprintln!(
            "loaded {} stocks x {} days ({} .. {}); {} symbol reports",
            panel.stocks.len(),
            panel.dates.len(),
            panel.dates.first().copied().unwrap_or(0),
            panel.dates.last().copied().unwrap_or(0),
            report.symbols.len()
        );
        let features = compute_features(&panel);
        let labels = compute_labels(&panel, &cfg.label_config()).map_err(wrap("labels"))?;
        let dates = panel
            .dates
            .iter()
            .map(|d| format!("{:04}-{:02}-{:02}", d / 10000, d / 100 % 100, d % 100))
            .collect();
        let years = panel.years();
        let mut h: u64 = 0xcbf29ce484222325;
        let mut mix = |x: u64| {
            h ^= x;
            h = h.wrapping_mul(0x100000001b3);
        };
        for d in &panel.dates {
            mix(*d as u64);
        }
        // Every field features, labels and the backtest read, plus presence.
        for s in panel.stocks.iter().chain(std::iter::once(&panel.market)).chain(&panel.sectors) {
            for b in s.symbol.bytes() {
                mix(b as u64);
            }
            for t in 0..s.present.len() {
                mix(s.present[t] as u64);
                if s.present[t] {
                    for v in [s.open[t], s.high[t], s.low[t], s.close[t], s.volume[t], s.dollar_volume[t]] {
                        mix(v.to_bits());
                    }
                }
            }
        }
        for (i, sec) in panel.sector_of.iter().enumerate() {
            mix(((i as u64) << 32) | *sec as u64);
        }
        let version = format!("bars-{h:016x}-{}d", panel.dates.len());
        Ok(Self {
            panel,
            features,
            labels,
            dates,
            years,
            version,
        })
    }

    /// Daily opens per stock (NaN when missing), for the backtest.
    pub fn opens(&self) -> Vec<Vec<f64>> {
        self.panel
            .stocks
            .iter()
            .map(|s| {
                s.open
                    .iter()
                    .zip(&s.present)
                    .map(|(o, p)| if *p { *o } else { f64::NAN })
                    .collect()
            })
            .collect()
    }
}

/// One fold's normalised features and sample sets.
pub struct FoldData {
    /// Features normalised with this fold's training statistics.
    pub normalized: FeatureTensor,
    /// The normaliser (saved with the fold).
    pub normalizer: Normalizer,
    /// Labelled, kept, input-valid samples per split; `Test` holds every
    /// input-valid test day (labelled or not), `CalTrade` is not a split here.
    pub splits: HashMap<Split, Vec<SampleIndex>>,
}

/// Prepare a fold: normalise on training days only, purge, check for leakage.
pub fn prepare_fold(ds: &Dataset, fold: &Fold, cfg: &ExperimentConfig) -> Result<FoldData> {
    let w = cfg.window;
    // C4: statistics from the feature rows of training days only.
    let normalizer = Normalizer::fit(&ds.features, fold.train.days()).map_err(wrap("normaliser"))?;
    let normalized = normalizer.apply(&ds.features);
    let ns = ds.features.num_securities;
    let mut labelled = Vec::new();
    let mut test_all = Vec::new();
    for s in 0..ns {
        for t in fold.train.start..fold.test.end {
            if !input_valid(&ds.features, s, t, w) {
                continue;
            }
            if fold.test.contains(t) {
                test_all.push(SampleIndex::new(s, t));
            }
            if ds.labels.class_of(s, t).is_some() {
                labelled.push(SampleIndex::new(s, t));
            }
        }
    }
    let purged = split_samples(fold, &labelled);
    check_no_leakage(fold, &purged, cfg.labels.horizon, cfg.folds.embargo)
        .map_err(|e| err(format!("fold {}: leakage guard: {e}", fold.test_year)))?;
    let mut splits = HashMap::new();
    splits.insert(Split::Train, purged.get(SegmentKind::Train).to_vec());
    splits.insert(Split::Val, purged.get(SegmentKind::Val).to_vec());
    splits.insert(Split::Cal, purged.get(SegmentKind::Cal).to_vec());
    splits.insert(Split::Test, test_all);
    for (name, split) in [("train", Split::Train), ("val", Split::Val), ("cal", Split::Cal)] {
        if splits[&split].is_empty() {
            return Err(err(format!("fold {}: empty {name} split", fold.test_year)));
        }
    }
    Ok(FoldData {
        normalized,
        normalizer,
        splits,

    })
}

/// FNV-1a of a list of samples (order-sensitive), for manifests.
pub fn samples_hash(samples: &[SampleIndex]) -> String {
    let mut h: u64 = 0xcbf29ce484222325;
    for smp in samples {
        for x in [smp.s as u64, smp.t as u64] {
            h ^= x;
            h = h.wrapping_mul(0x100000001b3);
        }
    }
    format!("{h:016x}-{}", samples.len())
}

/// What an external baseline must echo back for its predictions of a fold to be
/// accepted: the data, the fold boundaries and the exact sample keys of each split.
pub fn fold_manifest(ds: &Dataset, fold: &Fold, fd: &FoldData) -> serde_json::Value {
    let split = |k: Split| samples_hash(&fd.splits[&k]);
    let norm = serde_json::to_string(&fd.normalizer).unwrap_or_default();
    let mut h: u64 = 0xcbf29ce484222325;
    for b in norm.bytes() {
        h ^= b as u64;
        h = h.wrapping_mul(0x100000001b3);
    }
    serde_json::json!({
        "dataset_version": ds.version,
        "normalizer": format!("{h:016x}"),
        "fold": clm_eval::folds::render_folds_line(fold),
        "train": split(Split::Train),
        "val": split(Split::Val),
        "cal": split(Split::Cal),
        "test": split(Split::Test),
    })
}
//! Model-level tests: device forward against the `f64` reference, causality,
//! embedding properties, gradients, checkpoints, determinism, and learning a
//! planted synthetic signal.

use std::collections::HashMap;

use clm_data::synthetic::generate;
use clm_data::{LabelConfig, Normalizer, PlantedSignal, SampleIndex, SyntheticConfig, compute_features, compute_labels};
use clm_model::reference::encoder_reference;
use clm_model::{
    Batch, BatchSource, ContrastiveConfig, DecisionModel, EncoderConfig, HeadConfig, LossConfig,
    MambaConfig, ModelConfig, PanelSource, Pooling, SourceConfig, Split, TcnConfig, Temperature,
    TrainConfig, action_attributes, fit, input_valid, predict_split,
};
use mamba3::autograd::Var;
use mamba3::autograd::grad_mode::with_no_grad;
use mamba3::backend::Device;
use mamba3::backends::Auto;
use mamba3::nn::Module;
use mamba3::tensor::Tensor;
use mamba3::tensor::ops::random::Rng;
use mamba3::tensor::ops::selective_scan::SelectiveScanMode;

type R = Auto;

fn dev() -> Device<R> {
    Device::<R>::default()
}

fn small_mamba(input_dim: usize) -> MambaConfig {
    MambaConfig {
        input_dim,
        d_model: 16,
        d_state: 4,
        d_conv: 4,
        expand: 2,
        num_layers: 2,
        dt_rank: 0,
        dt_min: 1e-3,
        dt_max: 1e-1,
        pooling: Pooling::Last,
    }
}

fn clm_config(input_dim: usize, seed: u64) -> ModelConfig {
    ModelConfig {
        encoder: EncoderConfig::Mamba(small_mamba(input_dim)),
        head: HeadConfig::Contrastive(ContrastiveConfig {
            embed_dim: 8,
            hidden: 16,
            temperature: Temperature::Learned(0.2),
            scoring: clm_model::Scoring::Cosine,
        }),
        aux_return: true,
        aux_risk: true,
        aux_hidden: 8,
        action_attrs: action_attributes(5, 0.001, 0.0005),
        seed,
    }
}

fn noise(n: usize, seed: u64) -> Vec<f32> {
    Rng::seeded(seed).normal_vec(n, 0.0, 1.0)
}

#[test]
fn encoder_matches_f64_reference_in_both_schedules() {
    let dev = dev();
    let cfg = small_mamba(5);
    let (b, t) = (3, 23);
    let x = noise(b * t * 5, 1);
    let mut enc = clm_model::mamba::MambaEncoder::<R, f32>::new(&cfg, &dev, &mut Rng::seeded(4));
    let x64: Vec<f64> = x.iter().map(|&v| v as f64).collect();
    let want = encoder_reference(&enc, &x64, b, t);
    for mode in [SelectiveScanMode::Sequential, SelectiveScanMode::Chunked(4)] {
        enc.scan_mode = mode;
        let got = with_no_grad(|| {
            enc.sequence(&Var::constant(Tensor::from_f32(&x, vec![b, t, 5], &dev).unwrap()))
                .unwrap()
                .to_f32()
        });
        let scale = want.iter().fold(1.0f64, |m, v| m.max(v.abs()));
        for (i, (g, w)) in got.iter().zip(&want).enumerate() {
            assert!(((*g as f64) - w).abs() <= 2e-4 * scale, "{mode:?} [{i}] {g} vs {w}");
        }
    }
}

/// States at steps `<= t0` do not move when later inputs change.
#[test]
fn encoder_is_causal() {
    let dev = dev();
    let cfg = small_mamba(4);
    let enc = clm_model::mamba::MambaEncoder::<R, f32>::new(&cfg, &dev, &mut Rng::seeded(9));
    let (b, t, f) = (2, 16, 4);
    let x = noise(b * t * f, 3);
    let run = |x: &[f32]| {
        with_no_grad(|| {
            enc.sequence(&Var::constant(Tensor::from_f32(x, vec![b, t, f], &dev).unwrap()))
                .unwrap()
                .to_f32()
        })
    };
    let base = run(&x);
    for cut in [0usize, 7, 14] {
        let mut y = x.clone();
        for bi in 0..b {
            for tt in cut + 1..t {
                for k in 0..f {
                    y[(bi * t + tt) * f + k] += 5.0;
                }
            }
        }
        let out = run(&y);
        let d = cfg.d_model;
        for bi in 0..b {
            for tt in 0..=cut {
                for k in 0..d {
                    let i = (bi * t + tt) * d + k;
                    assert_eq!(out[i].to_bits(), base[i].to_bits(), "cut {cut} b {bi} t {tt}");
                }
            }
        }
    }
}

#[test]
fn embeddings_are_unit_norm_and_actions_ignore_the_state() {
    let dev = dev();
    let model = DecisionModel::<R, f32>::new(&clm_config(6, 1), &dev).unwrap();
    let (b, w, f) = (5, 12, 6);
    let run = |seed| {
        with_no_grad(|| {
            let x = Var::constant(Tensor::from_f32(&noise(b * w * f, seed), vec![b, w, f], &dev).unwrap());
            let o = model.forward(&x).unwrap();
            (o.scores.to_f32(), o.state_embedding.unwrap().to_f32())
        })
    };
    let (_, z) = run(1);
    for row in z.chunks(8) {
        let n: f32 = row.iter().map(|v| v * v).sum::<f32>().sqrt();
        assert!((n - 1.0).abs() < 1e-4, "state embedding norm {n}");
    }
    // The action branch reads only the action attributes: identical with any input,
    // and the cache returns the same values as a fresh computation.
    let head_actions = |model: &DecisionModel<R, f32>| {
        with_no_grad(|| {
            let x = Var::constant(Tensor::from_f32(&noise(w * f, 77), vec![1, w, f], &dev).unwrap());
            model.forward(&x).unwrap();
        });
        model.named_parameters().len()
    };
    let _ = head_actions(&model);
    let (s1, _) = run(2);
    model.invalidate();
    let (s2, _) = run(2);
    assert_eq!(s1, s2, "cached and fresh action embeddings disagree");
}

/// The full model's autograd gradient against central differences of the loss.
#[test]
fn model_gradients_match_finite_differences() {
    let dev = dev();
    let model = DecisionModel::<R, f32>::new(&clm_config(3, 2), &dev).unwrap();
    let (b, w, f) = (4, 6, 3);
    let batch = Batch {
        size: b,
        window: w,
        features: f,
        inputs: noise(b * w * f, 5),
        labels: vec![0, 1, 2, 0],
        positives: vec![1., 0., 0., 0., 1., 0., 0., 0., 1., 1., 0., 1.],
        weights: vec![1.0; b],
        ret_target: vec![0.5, -1.0, 0.1, 2.0],
        stop_target: vec![0.0, 1.0, 0.0, 0.0],
    };
    let loss_cfg = LossConfig {
        decision: 1.0,
        supcon: 0.5,
        supcon_temperature: 0.5,
        ret: 0.3,
        risk: 0.2,
        ret_clip: 5.0,
    };
    let loss_of = |m: &DecisionModel<R, f32>| -> Var<R, f32> {
        let x = Var::constant(Tensor::from_f32(&batch.inputs, vec![b, w, f], &dev).unwrap());
        clm_model::losses::total_loss(&m.forward(&x).unwrap(), &batch, &loss_cfg, &dev).unwrap()
    };
    let grads = loss_of(&model).backward().unwrap();
    let params = model.named_parameters();
    let mut checked = 0;
    for (name, p) in &params {
        let Some(g) = grads.get(p.id()) else {
            panic!("no gradient for {name}");
        };
        let g = g.to_f32();
        let base = p.value().to_f32();
        // A few coordinates per tensor keep the test fast.
        for &i in [0usize, base.len() / 2, base.len() - 1].iter() {
            let eps = 1e-2f32;
            let eval = |delta: f32| {
                let mut v = base.clone();
                v[i] += delta;
                p.set(Tensor::from_f32(&v, p.shape(), &dev).unwrap());
                model.invalidate();
                let l = with_no_grad(|| loss_of(&model).to_f32()[0]);
                p.set(Tensor::from_f32(&base, p.shape(), &dev).unwrap());
                l as f64
            };
            let fd = (eval(eps) - eval(-eps)) / (2.0 * eps as f64);
            let an = g[i] as f64;
            assert!(
                (fd - an).abs() <= 2e-2 * (1.0 + fd.abs().max(an.abs())),
                "{name}[{i}]: finite difference {fd:.6} vs autograd {an:.6}"
            );
            checked += 1;
        }
    }
    assert!(checked > 40, "checked {checked} coordinates");
}

#[test]
fn checkpoint_round_trip_restores_outputs() {
    let dev = dev();
    let cfg = clm_config(4, 3);
    let a = DecisionModel::<R, f32>::new(&cfg, &dev).unwrap();
    let b = DecisionModel::<R, f32>::new(&ModelConfig { seed: 99, ..cfg.clone() }, &dev).unwrap();
    let dir = std::env::temp_dir().join(format!("clm-ckpt-{}", std::process::id()));
    std::fs::create_dir_all(&dir).unwrap();
    let path = dir.join("model.ckpt");
    mamba3::train::checkpoint::Checkpoint::capture(&a, 7).save(&path).unwrap();
    let loaded = mamba3::train::checkpoint::Checkpoint::load(&path).unwrap();
    loaded.restore(&b, true).unwrap();
    b.invalidate();
    let x = noise(2 * 9 * 4, 8);
    let out = |m: &DecisionModel<R, f32>| {
        with_no_grad(|| {
            m.forward(&Var::constant(Tensor::from_f32(&x, vec![2, 9, 4], &dev).unwrap()))
                .unwrap()
                .scores
                .to_f32()
        })
    };
    assert_eq!(out(&a), out(&b));
    assert_eq!(loaded.step, 7);
    std::fs::remove_dir_all(&dir).ok();
}

/// A tiny synthetic fold with a planted, learnable signal.
fn synthetic_fold(
    seed: u64,
    window: usize,
) -> (clm_data::FeatureTensor, clm_data::Labels, HashMap<Split, Vec<SampleIndex>>) {
    let syn = generate(&SyntheticConfig {
        seed,
        num_days: 900,
        num_sectors: 2,
        stocks_per_sector: 6,
        missing_prob: 0.0,
        signal: Some(PlantedSignal {
            drift: 0.012,
            loading: 0.8,
        }),
    });
    let feats = compute_features(&syn.panel);
    let labels = compute_labels(
        &syn.panel,
        &LabelConfig {
            horizon: 1,
            kappa: 0.0002,
            margin_mult: 0.25,
            stop_frac: 0.03,
        },
    )
    .unwrap();
    let (train_end, val_end) = (650, 780);
    let norm = Normalizer::fit(&feats, 0..train_end).unwrap();
    let normed = norm.apply(&feats);
    let mut splits: HashMap<Split, Vec<SampleIndex>> = HashMap::new();
    for s in 0..feats.num_securities {
        for t in 0..feats.num_days {
            if !input_valid(&normed, s, t, window) || labels.class_of(s, t).is_none() {
                continue;
            }
            // Purge: h = 1, labels end at t + 2.
            let split = if t + 2 < train_end {
                Split::Train
            } else if (train_end..val_end).contains(&t) && t + 2 < val_end {
                Split::Val
            } else if t >= val_end {
                Split::Test
            } else {
                continue;
            };
            splits.entry(split).or_default().push(SampleIndex::new(s, t));
        }
    }
    (normed, labels, splits)
}

fn quick_train(steps: u64) -> TrainConfig {
    TrainConfig {
        max_steps: steps,
        batch_size: 64,
        learning_rate: 3e-3,
        weight_decay: 0.0,
        warmup_steps: 10,
        grad_clip: 1.0,
        eval_every: 50,
        patience: 100,
        eval_batch: 256,
        loss: LossConfig::default(),
        max_bad_steps: 5,
    }
}

/// Mamba + CLM learns the planted signal: held-out log loss beats the class
/// prior's and accuracy beats the majority class.
#[test]
fn clm_learns_planted_signal() {
    let dev = dev();
    let window = 8;
    let (feats, labels, splits) = synthetic_fold(11, window);
    let mut src = PanelSource::new(&feats, &labels, splits, SourceConfig { window, seed: 1, ..Default::default() });
    let model = DecisionModel::<R, f32>::new(&clm_config(feats.num_features, 5), &dev).unwrap();
    let report = fit(&model, &mut src, &quick_train(300), &dev, &mut |_| {}).unwrap();
    let test = predict_split(&model, &src, Split::Test, 256, &dev).unwrap();
    let n = test.labels.len() as f64;
    let mut counts = [0f64; 3];
    for &l in &test.labels {
        counts[l as usize] += 1.0;
    }
    let prior_nll: f64 = -counts.iter().filter(|&&c| c > 0.0).map(|c| c / n * (c / n).ln()).sum::<f64>();
    let probs = test.probabilities();
    let acc = probs
        .iter()
        .zip(&test.labels)
        .filter(|(p, l)| {
            let arg = (0..3).max_by(|&a, &b| p[a].total_cmp(&p[b])).unwrap();
            arg == **l as usize
        })
        .count() as f64
        / n;
    let majority = counts.iter().cloned().fold(0.0, f64::max) / n;
    eprintln!(
        "planted signal: test nll {:.4} vs prior {:.4}; acc {:.3} vs majority {:.3}; best step {}",
        test.nll(),
        prior_nll,
        acc,
        majority,
        report.best_step
    );
    assert!(test.nll() < prior_nll - 0.01, "no better than the prior");
    assert!(acc > majority + 0.02, "no better than the majority class");
}

