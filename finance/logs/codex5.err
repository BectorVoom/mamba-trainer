78	    },
79	    /// Two segments overlap or are out of order.
80	    #[error("segment {first:?} [{}, {}) does not end before {second:?} [{}, {}) starts", a.start, a.end, b.start, b.end)]
81	    SegmentOrder {
82	        /// The earlier kind.
83	        first: SegmentKind,
84	        /// Its range.
85	        a: Segment,
86	        /// The later kind.
87	        second: SegmentKind,
88	        /// Its range.
89	        b: Segment,
90	    },
91	    /// A sample listed under a segment does not lie in it.
