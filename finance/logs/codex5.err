152	///
153	/// `horizon` and `embargo` are passed separately from the fold on purpose: the guard
154	/// checks against the run's configured values, not whatever built the fold.
155	pub fn check_no_leakage(
156	    fold: &Fold,
157	    samples: &FoldSamples,
158	    horizon: usize,
159	    embargo: usize,
160	) -> Result<(), LeakageError> {
161	    let n = fold.n_days;
162	    let segs = fold.segments();
163	    for (k, &seg) in SegmentKind::ALL.iter().zip(segs.iter()) {
164	        if seg.end < seg.start || seg.end > n {
165	            return Err(LeakageError::SegmentOutOfRange {
166	                kind: *k,
167	                seg,
168	                n_days: n,
169	            });
170	        }
171	    }
172	    for i in 0..4 {
173	        for j in i + 1..4 {
174	            if segs[i].end > segs[j].start {
175	                return Err(LeakageError::SegmentOrder {
176	                    first: SegmentKind::ALL[i],
177	                    a: segs[i],
178	                    second: SegmentKind::ALL[j],
179	                    b: segs[j],
180	                });
181	            }
182	        }
183	    }
184	    for (i, &kind) in SegmentKind::ALL.iter().enumerate() {
185	        let seg = segs[i];
186	        for &sample in samples.get(kind) {
187	            let t = sample.day();
188	            if !seg.contains(t) {
189	                return Err(LeakageError::SampleOutsideSegment { kind, seg, sample });
190	            }
191	            // Saturating: an overflowing label end is certainly past every segment.
192	            let label_end = t.saturating_add(1).saturating_add(horizon);
193	            for (j, &later) in segs.iter().enumerate().skip(i + 1) {
194	                if label_end.saturating_add(embargo) >= later.start {
195	                    return Err(LeakageError::LabelOverlap {
196	                        kind,
197	                        sample,
198	                        label_end,
199	                        embargo,
200	                        later: SegmentKind::ALL[j],
201	                        later_start: later.start,
202	                    });
203	                }
204	            }
205	            if kind == SegmentKind::Test && (n == 0 || label_end > n - 1) {
206	                return Err(LeakageError::TestLabelPastEnd {
207	                    sample,
208	                    label_end,
209	                    n_days: n,
210	                });
211	            }
212	        }
213	    }
214	    Ok(())
215	}
216	
217	/// C4 property 3: test segments of different folds are pairwise disjoint and
218	/// increasing (in the given order).
219	pub fn check_folds_disjoint(folds: &[Fold]) -> Result<(), LeakageError> {
220	    for (i, a) in folds.iter().enumerate() {
221	        for (j, b) in folds.iter().enumerate().skip(i + 1) {
222	            if a.test.end > b.test.start || a.test.start >= b.test.start {
223	                return Err(LeakageError::TestSegmentsOverlap {
224	                    first: i,
225	                    a: a.test,
226	                    second: j,
227	                    b: b.test,
228	                });
229	            }
230	        }
231	    }
232	    Ok(())
233	}
