186	
187	/// Units below which the forward takes the chunked schedule under
188	/// [`SelectiveScanMode::Auto`].
189	const AUTO_SEQUENTIAL_UNITS: usize = 8192;
190	
191	/// Chunk length for the chunked schedule (a multiple of `seg`).
192	fn chunk_len(mode: SelectiveScanMode, d: &Dims, seg: usize) -> Option<usize> {
193	    let raw = match mode {
194	        SelectiveScanMode::Sequential => return None,
195	        SelectiveScanMode::Chunked(l) => l.clamp(1, d.seq.max(1)),
196	        SelectiveScanMode::Auto => {
197	            let units = d.batch * d.dim;
198	            if units >= AUTO_SEQUENTIAL_UNITS || d.seq <= 2 * seg {
199	                return None;
200	            }
201	            // Enough chunks to reach the sequential threshold, but at least two
202	            // segments per chunk so phase 2 stays short relative to the rest.
203	            let chunks = AUTO_SEQUENTIAL_UNITS.div_ceil(units).max(2);
204	            d.seq.div_ceil(chunks).max(2 * seg)
205	        }
206	    };
207	    Some(raw.div_ceil(seg) * seg)
208	}
