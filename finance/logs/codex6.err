805	/// [`search`] for several jobs with one decoder call per step
806	/// ([`beam_search_groups`]): the jobs are encoded as one batch and every job
807	/// has a block of the decoder's rows.
808	fn search_groups(
809	    model: &MotifModel<R, f32>,
810	    uses_spectrum: bool,
811	    vocab: &MotifVocab,
812	    jobs: &[SearchJob<'_>],
813	    threads: usize,
814	    device: &Device<R>,
815	) -> Result<Vec<BeamOutput>> {
816	    let n_out = model.config().n_out_padded();
817	    // The root step has one row per job: the last job is repeated up to a
818	    // multiple of 32 rows, as every later step's rows are, so that the
819	    // device sees few shapes. The search does not read the added rows.
820	    let last = jobs.len() - 1;
821	    let padded = jobs.len().div_ceil(32) * 32;
822	    let at = |i: usize| &jobs[i.min(last)];
823	    let formulas: Vec<Formula> = (0..padded).map(|i| *at(i).formula).collect();
824	    let prints: Vec<SparseFingerprint> = (0..padded).map(|i| at(i).fingerprint.clone()).collect();
825	    let fingerprints = FingerprintBatch::build(&prints, FINGERPRINT_SLOTS)?;
826	    let spectra = if uses_spectrum {
827	        let evidence: Vec<Option<&SpectrumEvidence>> = (0..padded).map(|i| at(i).spectrum).collect();
